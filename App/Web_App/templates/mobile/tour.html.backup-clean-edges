    <div class="screen">
        <!-- Persistent Header -->
        <header class="tour-header">
            <div class="header-left">
                <span class="status-badge" id="tour-status">
                    <span class="pulse-dot"></span> Active
                </span>
            </div>
            <div class="header-right">
                <button class="btn-icon-sm" id="music-toggle" aria-label="Toggle Music">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/>
                        <circle cx="18" cy="16" r="3"/>
                    </svg>
                </button>
                <button class="btn-icon-sm" onclick="endTour()" aria-label="End Tour">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="tour-content">

            <!-- Map Layer (Background) -->
            <div id="tour-map" class="tour-map-bg"></div>

            <!-- Route Info Overlay -->
            <div class="route-info glass-card-sm glass-overlay top-overlay">
                <div class="route-info-row">
                    <div class="info-item">
                        <span class="label">Next Stop</span>
                        <span class="value" id="next-stop-name">Calculating...</span>
                    </div>
                    <div class="info-item right">
                        <span class="label">ETA</span>
                        <span class="value" id="journey-eta">-- min</span>
                    </div>
                </div>
            </div>

            <!-- Landmark Cards Carousel -->
            <div class="cards-section">
                <div class="swiper landmark-swiper">
                    <div class="swiper-wrapper" id="landmark-cards">
                        <!-- Cards will be dynamically inserted here -->
                    </div>
                </div>
            </div>

            <!-- Pagination outside cards section -->
            <div class="swiper-pagination"></div>

        </main>
    </div>

    <!-- Pass API Key -->
    <script>
        const GOOGLE_MAPS_KEY = "{{ google_maps_key }}";
    </script>

    <!-- Dependencies -->
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_key }}&libraries=geometry&callback=initMap" async defer></script>

    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- App Logic -->
    <script src="/static/mobile/js/tour_logic.js?v=5"></script>
