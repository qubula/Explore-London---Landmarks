# Copy to .env and fill in your own values. Never commit .env.

# Google Maps key used in the browser (Maps JavaScript API + Places API).
# Restrict it to your website in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=

# Google key used by the server for route planning (Directions API).
# Never exposed to the browser.
GOOGLE_DIRECTIONS_KEY=

# Only needed for the offline data-building scripts (not the live site)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
